; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[accessibility]

general/accessibility_support=true

[application]

config/name="错位大侦探"
config/version="0.1.0"
run/main_scene="res://scenes/bootstrap/bootstrap.tscn"
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0.063, 0.165, 0.208, 1)
boot_splash/show_image=false
boot_splash/stretch_mode=0
boot_splash/image="res://assets/branding/guagua-rabbit-logo.png"
config/icon="res://assets/branding/guagua-rabbit-logo.png"

[autoload]

SessionStore="*res://scripts/storage/session_store.gd"
Preferences="*res://scripts/storage/preferences.gd"
ApiClient="*res://scripts/api/api_client.gd"
LanguagePackManager="*res://scripts/localization/language_pack_manager.gd"
LocaleManager="*res://scripts/localization/locale_manager.gd"
CatalogRepository="*res://scripts/catalog/catalog_repository.gd"
ProgressStore="*res://scripts/storage/progress_store.gd"
SyncQueue="*res://scripts/storage/sync_queue.gd"
Analytics="*res://scripts/analytics/analytics.gd"
Monetization="*res://scripts/monetization/monetization.gd"
AudioManager="*res://scripts/audio/audio_manager.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/handheld/orientation=6

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-minigame/plugin.cfg")

[gui]

theme/custom_font="res://assets/fonts/NotoSansSC-Wechat.ttf"
theme/default_font_size=22

[internationalization]

locale/translations=PackedStringArray("res://i18n/zh_CN.po", "res://i18n/en_US.po")

[oddspot]

network/production_base_url="https://oddspot.guaguatu.com"
network/user_server_base_url="https://api.guaguatu.com"
network/user_server_app_id="game_odd_spot"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.063, 0.165, 0.208, 1)
