bbcode_enabled = true
fit_content = true
text = "[b]隐私说明[/b]\n\n默认使用匿名账号，不收集姓名。安装标识在服务端仅保存 HMAC；访问令牌仅保存哈希。关闭匿名分析后不再产生新分析事件。广告和购买由平台适配器验证，正式接入前使用 Mock。"

