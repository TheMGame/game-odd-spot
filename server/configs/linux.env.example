ODDSPOT_ENV=production
ODDSPOT_HTTP_ADDR=127.0.0.1:8080
ODDSPOT_DATABASE_DSN='USER:PASSWORD@tcp(HOST:PORT)/DATABASE?parseTime=true&charset=utf8mb4&loc=UTC'
ODDSPOT_INSTALLATION_HMAC_KEY='CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS'
ODDSPOT_ADMIN_TOKEN='CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS'
ODDSPOT_DEFAULT_MARKET=global
ODDSPOT_DEFAULT_LOCALE=zh-CN
ODDSPOT_LOG_LEVEL=info
ODDSPOT_CONTENT_DIR=/opt/oddspot/storage/content
ODDSPOT_ADMIN_DIR=/opt/oddspot/admin
ODDSPOT_PUBLIC_BASE_URL=https://api.example.com
ODDSPOT_USER_SERVER_BASE_URL=https://api.guaguatu.com
ODDSPOT_USER_SERVER_APP_ID=game_odd_spot
