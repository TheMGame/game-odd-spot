ODDSPOT_ENV=development
ODDSPOT_HTTP_ADDR=127.0.0.1:8080
ODDSPOT_INSTALLATION_HMAC_KEY=oddspot-development-test-hmac-key-2026
ODDSPOT_ADMIN_TOKEN=oddspot-development-admin-token

