# Development-only values. Do not use this HMAC key in production.
ODDSPOT_ENV=development
ODDSPOT_HTTP_ADDR=127.0.0.1:8080
ODDSPOT_INSTALLATION_HMAC_KEY=oddspot-development-test-hmac-key-2026
ODDSPOT_ADMIN_TOKEN=oddspot-development-admin-token
ODDSPOT_USER_SERVER_BASE_URL=http://127.0.0.1:8081
ODDSPOT_USER_SERVER_APP_ID=game_odd_spot
ODDSPOT_GEO_COUNTRY_HEADER=CF-IPCountry

# JSON array of published downloadable languages. Chinese and English are always built in.
# ODDSPOT_REMOTE_LOCALES_JSON=[{"locale":"fr-FR","display_name":"French","native_name":"Français","builtin":false,"version":1,"country_codes":["FR"],"download_url":"https://cdn.example.com/i18n/fr-FR-v1.pck","sha256":"...","size_bytes":123456,"resource_path":"res://i18n/fr_FR.translation"}]

# Supply the DSN in your shell or an ignored local env file. Never commit its password.
# ODDSPOT_DATABASE_DSN=user:password@tcp(host:port)/database?parseTime=true&charset=utf8mb4&loc=UTC
