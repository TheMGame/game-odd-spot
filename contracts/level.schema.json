{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game.example.com/schemas/level.schema.json",
  "title": "Odd Spot Runtime Level",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "level_id", "level_version", "mode", "assets", "tags", "difficulty"],
  "properties": {
    "schema_version": {"const": 1},
    "level_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{7,63}$"},
    "level_version": {"type": "integer", "minimum": 1},
    "mode": {"enum": ["find_anachronism", "image_puzzle", "interactive_story"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 100},
    "instruction": {"type": "string", "minLength": 1, "maxLength": 160},
    "background_knowledge": {"type": "string", "maxLength": 8000},
    "cover": {"$ref": "#/$defs/asset"},
    "time_limit_seconds": {"type": "integer", "minimum": 0, "maximum": 3600, "default": 180},
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {"$ref": "#/$defs/asset"},
        "music": {"$ref": "#/$defs/asset"},
        "base": {"$ref": "#/$defs/asset"},
        "target": {"$ref": "#/$defs/asset"},
        "thumbnail": {"$ref": "#/$defs/asset"},
        "width": {"type": "integer", "minimum": 512, "maximum": 8192},
        "height": {"type": "integer", "minimum": 512, "maximum": 8192}
      }
    },
    "differences": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/difference"}
    },
    "puzzle": {"$ref": "#/$defs/puzzle"},
    "story": {"$ref": "#/$defs/story"},
    "tags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regions", "themes", "styles", "scenes", "risk"],
      "properties": {
        "regions": {"$ref": "#/$defs/stringSet"},
        "themes": {"$ref": "#/$defs/stringSet"},
        "styles": {"$ref": "#/$defs/stringSet"},
        "scenes": {"$ref": "#/$defs/stringSet"},
        "season": {"$ref": "#/$defs/stringSet"},
        "audience": {"$ref": "#/$defs/stringSet"},
        "risk": {"$ref": "#/$defs/stringSet"}
      }
    },
    "difficulty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "object_size", "color_similarity", "visual_density", "edge_distance", "semantic_obviousness"],
      "properties": {
        "total": {"$ref": "#/$defs/rating"},
        "object_size": {"$ref": "#/$defs/rating"},
        "color_similarity": {"$ref": "#/$defs/rating"},
        "visual_density": {"$ref": "#/$defs/rating"},
        "edge_distance": {"$ref": "#/$defs/rating"},
        "semantic_obviousness": {"$ref": "#/$defs/rating"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "find_anachronism"}}},
      "then": {
        "required": ["differences"],
        "not": {"required": ["puzzle"]},
        "properties": {"assets": {"required": ["image", "width", "height"], "not": {"anyOf": [{"required": ["base"]}, {"required": ["target"]}]}}}
      }
    },
    {
      "if": {"properties": {"mode": {"const": "image_puzzle"}}},
      "then": {
        "required": ["puzzle"],
        "not": {"required": ["differences"]},
        "properties": {"assets": {"required": ["image", "width", "height"], "not": {"anyOf": [{"required": ["base"]}, {"required": ["target"]}]}}}
      }
    },
    {
      "if": {"properties": {"mode": {"const": "interactive_story"}}},
      "then": {
        "required": ["story"],
        "not": {"anyOf": [{"required": ["differences"]}, {"required": ["puzzle"]}]}
      }
    }
  ],
  "$defs": {
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_node", "nodes"],
      "properties": {
        "start_node": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"},
        "nodes": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 300,
          "additionalProperties": {"$ref": "#/$defs/storyNode"}
        }
      }
    },
    "storyNode": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"enum": ["scene", "dialogue", "choice", "hotspot", "evidence", "sequence", "puzzle", "ending"]},
        "title": {"type": "string", "maxLength": 100},
        "speaker": {"type": "string", "maxLength": 64},
        "text": {"type": "string", "maxLength": 4000},
        "image": {"$ref": "#/$defs/asset"},
        "music": {"$ref": "#/$defs/audioAsset"},
        "voice": {"$ref": "#/$defs/audioAsset"},
        "effect": {"$ref": "#/$defs/audioAsset"},
        "next": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"},
        "ending_id": {"type": "string", "maxLength": 64},
        "evidence_id": {"type": "string", "maxLength": 64},
        "required": {"type": "integer", "minimum": 1, "maximum": 20},
        "choices": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/storyChoice"}},
        "hotspots": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/storyHotspot"}},
        "items": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/storyItem"}},
        "correct_order": {"type": "array", "maxItems": 12, "items": {"type": "string"}},
        "puzzle": {"$ref": "#/$defs/puzzle"},
        "set": {"type": "object"}
      },
      "additionalProperties": true
    },
    "storyChoice": {"type": "object", "required": ["id", "label", "next"], "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "next": {"type": "string"}, "set": {"type": "object"}}, "additionalProperties": false},
    "storyHotspot": {"type": "object", "required": ["id", "x", "y"], "properties": {"id": {"type": "string"}, "x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "minimum": 0, "maximum": 1}, "radius": {"type": "number", "minimum": 0.01, "maximum": 0.25}, "label": {"type": "string"}, "evidence_id": {"type": "string"}}, "additionalProperties": false},
    "storyItem": {"type": "object", "required": ["id", "label"], "properties": {"id": {"type": "string"}, "label": {"type": "string"}}, "additionalProperties": false},
    "puzzle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows", "cols"],
      "properties": {
        "rows": {"type": "integer", "minimum": 2, "maximum": 8},
        "cols": {"type": "integer", "minimum": 2, "maximum": 8},
        "time_limit_seconds": {"type": "integer", "minimum": 0, "maximum": 3600},
        "operations": {"type": "array", "minItems": 0, "maxItems": 24, "items": {"$ref": "#/$defs/puzzleOperation"}}
      }
    },
    "puzzleOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "cells"],
      "properties": {
        "type": {"const": "swap"},
        "cells": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}
      }
    },
    "rating": {"type": "integer", "minimum": 1, "maximum": 5},
    "stringSet": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"}},
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "url", "sha256", "bytes", "content_type"],
      "properties": {
        "asset_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{8,128}$"},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 1},
        "content_type": {"enum": ["image/webp", "image/png", "image/jpeg"]}
      }
    },
    "audioAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "url", "sha256", "bytes", "content_type"],
      "properties": {
        "asset_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{8,128}$"},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 1},
        "content_type": {"enum": ["audio/mpeg", "audio/mp4", "audio/wav", "audio/ogg"]},
        "volume": {"type": "number", "minimum": 0, "maximum": 1},
        "loop": {"type": "boolean"}
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "difference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "shape", "difficulty", "operation"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,32}$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 64},
        "era": {"type": "string", "minLength": 1, "maxLength": 64},
        "explanation": {"type": "string", "minLength": 1, "maxLength": 300},
        "shape": {"enum": ["circle", "polygon"]},
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1},
        "radius": {"type": "number", "minimum": 0.005, "maximum": 0.25},
        "points": {"type": "array", "minItems": 3, "maxItems": 64, "items": {"$ref": "#/$defs/point"}},
        "difficulty": {"$ref": "#/$defs/rating"},
        "operation": {"enum": ["add", "remove", "replace", "color", "shape", "count", "direction", "texture", "anachronism"]},
        "mask": {"$ref": "#/$defs/asset"}
      },
      "allOf": [
        {"if": {"properties": {"shape": {"const": "circle"}}}, "then": {"required": ["x", "y", "radius"], "not": {"required": ["points"]}}},
        {"if": {"properties": {"shape": {"const": "polygon"}}}, "then": {"required": ["points"], "not": {"anyOf": [{"required": ["x"]}, {"required": ["y"]}, {"required": ["radius"]}]}}}
      ]
    }
  }
}
